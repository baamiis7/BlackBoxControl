<UserControl x:Class="BlackBoxControl.LoopDeviceForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ STICKY HEADER ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Device image -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="4"
                        Margin="0,0,12,0">
                    <Image Source="{Binding Device.ImagePath}" Width="40" Height="40" Stretch="Uniform"/>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Device Configuration" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="{Binding Device.Type}" FontSize="11"
                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                </StackPanel>

                <!-- Status pill -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource SuccessBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="10,5" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Address -->
                <Border Grid.Column="3"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="10,5" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Addr: " FontSize="11"
                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                        <TextBlock Text="{Binding Device.Address}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Analog value -->
                <Border Grid.Column="4"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Analog: " FontSize="11"
                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                        <TextBlock Text="{Binding Device.AnalogValue, StringFormat={}{0}%}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ SCROLLABLE CONTENT ═══ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left Column ── -->
                <StackPanel Grid.Column="0">

                    <GroupBox Header="Basic Information" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Device Type:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Device.Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" Background="{DynamicResource SurfaceBrush}"
                                     Margin="0,0,0,7" ToolTip="Determined by the device selected"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Location:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Device.LocationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,7"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Address:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding Device.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Detection Settings" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Analog Value:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Device.AnalogValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,4,7"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="%"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" Margin="0,0,0,7"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Threshold:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Device.DeviceThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,4,7"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="%"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundDimBrush}" Margin="0,0,0,7"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Day Sensitivity:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <Slider Grid.Row="2" Grid.Column="1"
                                    Minimum="0" Maximum="100" TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Device.DeviceDaySensitivity, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,4,7"/>
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Text="{Binding Device.DeviceDaySensitivity, StringFormat={}{0:0}}"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,7"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Night Sensitivity:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <Slider Grid.Row="3" Grid.Column="1"
                                    Minimum="0" Maximum="100" TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Device.DeviceNightSensitivity, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="2"
                                       Text="{Binding Device.DeviceNightSensitivity, StringFormat={}{0:0}}"
                                       VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                        </Grid>
                    </GroupBox>

                    <!-- Analog level bar -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Analog Level" FontSize="11"
                                           Foreground="{DynamicResource ForegroundDimBrush}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Device.AnalogValue, StringFormat={}{0}%}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Height="8">
                                <Border HorizontalAlignment="Left"
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="2"
                                        Width="{Binding Device.AnalogValue, Converter={StaticResource PercentageToWidthConverter}}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ── Right Column ── -->
                <StackPanel Grid.Column="2">

                    <GroupBox Header="Action Configuration" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Input Action:"
                                   VerticalAlignment="Center" Padding="5,3"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding InputActions}"
                                      SelectedItem="{Binding Device.DeviceInputAction, Mode=TwoWay}"
                                      Margin="0,0,0,8"
                                      ToolTip="Action when device activates"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Action Message:"
                                   VerticalAlignment="Top" Padding="5,10,5,3"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Device.DeviceActionMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     MinHeight="90" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </GroupBox>

                    <!-- Tips — compact, no heavy GroupBox -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Configuration Tips" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="✓ " Foreground="{DynamicResource SuccessBrush}"
                                           FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Day sensitivity: lower value = more sensitive"
                                           FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="✓ " Foreground="{DynamicResource SuccessBrush}"
                                           FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Night sensitivity: adjust for ambient lighting"
                                           FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠ " Foreground="{DynamicResource WarningBrush}"
                                           FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Threshold must be above current analog value"
                                           FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══ STICKY FOOTER ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="Save Changes"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="110"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
