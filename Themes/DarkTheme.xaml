<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/BaseStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════
         DARK THEME  —  Charcoal + Fire Orange
         Industrial feel; appropriate for fire-safety tools.
    ═══════════════════════════════════════════════════ -->

    <!-- Accent / brand -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#E07B39"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#C86A28"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#B05A18"/>
    <SolidColorBrush x:Key="SecondaryBrush"      Color="#5BC4BF"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="#E07B39"/>

    <!-- Semantic colours -->
    <SolidColorBrush x:Key="SuccessBrush"  Color="#3DC97E"/>
    <SolidColorBrush x:Key="DangerBrush"   Color="#E05252"/>
    <SolidColorBrush x:Key="WarningBrush"  Color="#F0B429"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#111111"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TitleBarBrush"   Color="#212121"/>
    <SolidColorBrush x:Key="MenuBarBrush"    Color="#1A1A1A"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="#2E2E2E"/>
    <SolidColorBrush x:Key="HoverBrush"      Color="#272727"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundBrush"         Color="#D9D9D9"/>
    <SolidColorBrush x:Key="ForegroundDimBrush"      Color="#737373"/>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#404040"/>

</ResourceDictionary>
