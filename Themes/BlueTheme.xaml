<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/BaseStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════
         BLUE THEME  —  Midnight Navy + Azure
         Corporate / professional; clean high-contrast blue.
    ═══════════════════════════════════════════════════ -->

    <!-- Accent / brand -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#3B9BFF"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#2B8BEF"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1B7BDF"/>
    <SolidColorBrush x:Key="SecondaryBrush"      Color="#9B7BEF"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="#3B9BFF"/>

    <!-- Semantic colours -->
    <SolidColorBrush x:Key="SuccessBrush"  Color="#2EA043"/>
    <SolidColorBrush x:Key="DangerBrush"   Color="#F85149"/>
    <SolidColorBrush x:Key="WarningBrush"  Color="#D29922"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="#161B22"/>
    <SolidColorBrush x:Key="TitleBarBrush"   Color="#1C2128"/>
    <SolidColorBrush x:Key="MenuBarBrush"    Color="#161B22"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="#30363D"/>
    <SolidColorBrush x:Key="HoverBrush"      Color="#21262D"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundBrush"         Color="#E6EDF3"/>
    <SolidColorBrush x:Key="ForegroundDimBrush"      Color="#7D8590"/>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#30363D"/>

</ResourceDictionary>
