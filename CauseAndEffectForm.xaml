<UserControl x:Class="BlackBoxControl.CauseAndEffectForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <!--
        Layout: 3 rows
          Row 0 (Auto)  — compact sticky header: title, name, status, action buttons
          Row 1 (*)     — three-column main area (Causes | Logic | Effects)
          Row 2 (Auto)  — summary + status strip
        No outer ScrollViewer — device lists own their * height; no nested-scroll conflict.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════ ROW 0 — HEADER BAR ══════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cause &amp; Effect Configuration"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="Define input → output logic rules for this panel"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- C&E name + status (inline, centre of header) -->
                <Grid Grid.Column="2" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Name:"
                           VerticalAlignment="Center" Padding="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding CauseEffect.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             ToolTip="Unique name for this Cause and Effect rule"/>

                    <Label Grid.Column="3" Content="Status:"
                           VerticalAlignment="Center" Padding="0,0,6,0"/>
                    <CheckBox Grid.Column="4"
                              IsChecked="{Binding CauseEffect.IsEnabled, Mode=TwoWay}"
                              Content="Enabled"
                              VerticalAlignment="Center"/>

                    <Border Grid.Column="6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SecondaryBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="7,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CauseEffect.Status}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>
                </Grid>

                <!-- Action buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Test"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="70" Margin="0,0,6,0"
                            Command="{Binding TestConfigCommand}"/>
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="70" Margin="0,0,6,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="Save C&amp;E"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="100"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ ROW 1 — THREE-COLUMN MAIN AREA ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column separators -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}"/>
            <Rectangle Grid.Column="3" Fill="{DynamicResource BorderBrush}"/>

            <!-- ─── CAUSES (left) ──────────────────────────── -->
            <Grid Grid.Column="0" Margin="14,12,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Column header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="CAUSES  (Inputs)"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Input devices / schedules that trigger this rule"
                               FontSize="11"
                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                </StackPanel>

                <!-- Search + select/clear + count (compact row) -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,5" Margin="0,0,0,6">
                        <Grid>
                            <TextBox Text="{Binding InputSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FontSize="12"/>
                            <TextBlock Text="🔍  Search inputs…"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontSize="12" IsHitTestVisible="False" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Select/Clear + count badge -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Select All"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,4" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding SelectAllInputsCommand}"/>
                        <Button Grid.Column="1" Content="Clear All"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,4" FontSize="11" Margin="4,0,8,0"
                                Command="{Binding ClearAllInputsCommand}"/>
                        <Border Grid.Column="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedInputsCount, Mode=OneWay}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text=" selected"
                                           FontSize="11"
                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Device list — fills * row -->
                <Border Grid.Row="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5"
                        Margin="0,0,0,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding GroupedInputDevices}" Padding="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding GroupName}"
                                              IsExpanded="True"
                                              Foreground="{DynamicResource PrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              BorderThickness="1"
                                              Margin="0,0,0,6">
                                        <ItemsControl ItemsSource="{Binding Devices}" Padding="4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="4"
                                                            Padding="8" Margin="0,0,0,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <Image Grid.Column="1"
                                                                   Source="{Binding ImagePath}"
                                                                   Width="22" Height="22"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Type}"
                                                                           FontWeight="Medium" FontSize="12"
                                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                                <TextBlock Foreground="{DynamicResource ForegroundDimBrush}"
                                                                           FontSize="10">
                                                                    <Run Text="Addr:"/>
                                                                    <Run Text="{Binding Address}" FontWeight="Medium"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding LocationText}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Advanced Inputs expander (row 4, auto height) -->
                <Expander Grid.Row="4"
                          Header="⏰  ADVANCED INPUTS"
                          BorderBrush="{DynamicResource PrimaryBrush}"
                          BorderThickness="1">
                    <Border Background="{DynamicResource SurfaceBrush}" Padding="8" MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Time of Day -->
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="🕐  Time of Day"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Button Content="+ Add"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,2" FontSize="10"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding AddTimeOfDayInputCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding TimeOfDayInputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="3"
                                                            Padding="8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="From:"
                                                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding StartTime, StringFormat='hh\\:mm'}"
                                                                         Margin="0,0,8,0"/>
                                                                <TextBlock Grid.Column="2" Text="To:"
                                                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Grid.Column="3"
                                                                         Text="{Binding EndTime, StringFormat='hh\\:mm'}"/>
                                                            </Grid>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="5,2" FontSize="11" Margin="6,0,0,0"
                                                                    Command="{Binding DataContext.RemoveTimeOfDayInputCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No time schedules added"
                                                   FontStyle="Italic" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TimeOfDayInputs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Date / Time -->
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="📅  Specific Date / Time"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Button Content="+ Add"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,2" FontSize="10"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding AddDateTimeInputCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DateTimeInputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="3"
                                                            Padding="8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Trigger Date and Time:"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <DatePicker SelectedDate="{Binding TriggerDateTime, Mode=TwoWay}"
                                                                            Margin="0,0,0,4"/>
                                                                <TextBox Text="{Binding TriggerDateTime, StringFormat='HH:mm'}"
                                                                         Width="80" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="5,2" FontSize="11" Margin="6,0,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Command="{Binding DataContext.RemoveDateTimeInputCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No date/time triggers added"
                                                   FontStyle="Italic" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DateTimeInputs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- API Webhook -->
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="🌐  API Webhook"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Button Content="+ Add"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,2" FontSize="10"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding AddReceiveApiInputCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding ReceiveApiInputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="3"
                                                            Padding="8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding HttpMethod}"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}">
                                                                    <Run Text="{Binding ListenUrl}"/>
                                                                    <Run Text="{Binding ExpectedPath}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="5,2" FontSize="11" Margin="6,0,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Command="{Binding DataContext.RemoveReceiveApiInputCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No API webhooks configured"
                                                   FontStyle="Italic" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReceiveApiInputs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>

            <!-- ─── LOGIC GATE (centre) ───────────────────────── -->
            <Grid Grid.Column="2">
                <StackPanel VerticalAlignment="Center" Margin="8,0">

                    <TextBlock Text="LOGIC"
                               FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundDimBrush}"
                               Margin="0,0,0,14"/>

                    <!-- OR -->
                    <RadioButton GroupName="LogicGate"
                                 IsChecked="{Binding CauseEffect.LogicGate,
                                     Converter={StaticResource EnumToBoolConverter}, ConverterParameter=OR}"
                                 Margin="0,0,0,8">
                        <RadioButton.Content>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="10,7" MinWidth="120">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{StaticResource OrGateIcon}"
                                           Width="56" Height="36" Margin="0,0,0,4"/>
                                    <TextBlock Text="OR" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="Any input" FontSize="9"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </RadioButton.Content>
                    </RadioButton>

                    <!-- AND -->
                    <RadioButton GroupName="LogicGate"
                                 IsChecked="{Binding CauseEffect.LogicGate,
                                     Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AND}"
                                 Margin="0,0,0,8">
                        <RadioButton.Content>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="10,7" MinWidth="120">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{StaticResource AndGateIcon}"
                                           Width="56" Height="36" Margin="0,0,0,4"/>
                                    <TextBlock Text="AND" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryBrush}"/>
                                    <TextBlock Text="All inputs" FontSize="9"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </RadioButton.Content>
                    </RadioButton>

                    <!-- XOR -->
                    <RadioButton GroupName="LogicGate"
                                 IsChecked="{Binding CauseEffect.LogicGate,
                                     Converter={StaticResource EnumToBoolConverter}, ConverterParameter=XOR}"
                                 Margin="0,0,0,14">
                        <RadioButton.Content>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="5"
                                    Padding="10,7" MinWidth="120">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{StaticResource XorGateIcon}"
                                           Width="56" Height="36" Margin="0,0,0,4"/>
                                    <TextBlock Text="XOR" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="One only" FontSize="9"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                                </StackPanel>
                            </Border>
                        </RadioButton.Content>
                    </RadioButton>

                    <!-- Arrow -->
                    <TextBlock Text="→" FontSize="28"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,14"/>

                    <!-- Logic description -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <TextBlock Text="{Binding LogicGateDescription}"
                                   FontSize="10" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- ─── EFFECTS (right) ───────────────────────────── -->
            <Grid Grid.Column="4" Margin="10,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Column header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="EFFECTS  (Outputs)"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryBrush}"/>
                    <TextBlock Text="Output devices to activate when rule fires"
                               FontSize="11"
                               Foreground="{DynamicResource ForegroundDimBrush}"/>
                </StackPanel>

                <!-- Search + select/clear + count -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,5" Margin="0,0,0,6">
                        <Grid>
                            <TextBox Text="{Binding OutputSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0" FontSize="12"/>
                            <TextBlock Text="🔍  Search outputs…"
                                       Foreground="{DynamicResource ForegroundDimBrush}"
                                       FontSize="12" IsHitTestVisible="False" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutputSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Select All"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,4" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding SelectAllOutputsCommand}"/>
                        <Button Grid.Column="1" Content="Clear All"
                                Style="{StaticResource SecondaryButton}"
                                Padding="6,4" FontSize="11" Margin="4,0,8,0"
                                Command="{Binding ClearAllOutputsCommand}"/>
                        <Border Grid.Column="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedOutputsCount, Mode=OneWay}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource SecondaryBrush}"/>
                                <TextBlock Text=" selected" FontSize="11"
                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Output device list — fills * row -->
                <Border Grid.Row="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5"
                        Margin="0,0,0,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OutputDevices}" Padding="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            Padding="8" Margin="0,0,0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Image Grid.Column="1"
                                                   Source="{Binding ImagePath}"
                                                   Width="22" Height="22"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}"
                                                           FontWeight="Medium" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Foreground="{DynamicResource ForegroundDimBrush}"
                                                           FontSize="10">
                                                    <Run Text="Addr:"/>
                                                    <Run Text="{Binding Address}" FontWeight="Medium"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding LocationText}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Advanced Outputs expander (row 4) -->
                <Expander Grid.Row="4"
                          Header="📡  ADVANCED OUTPUTS"
                          BorderBrush="{DynamicResource SecondaryBrush}"
                          BorderThickness="1">
                    <Border Background="{DynamicResource SurfaceBrush}" Padding="8" MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Send SMS -->
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="📱  Send SMS"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Button Content="+ Add"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,2" FontSize="10"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding AddSendTextOutputCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SendTextOutputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="3"
                                                            Padding="8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Phone Number:"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Text="{Binding PhoneNumber, Mode=TwoWay}"
                                                                         Margin="0,0,0,5"/>
                                                                <TextBlock Text="Message:"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Text="{Binding Message, Mode=TwoWay}"
                                                                         Height="44" TextWrapping="Wrap"
                                                                         AcceptsReturn="True"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="5,2" FontSize="11" Margin="6,0,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Command="{Binding DataContext.RemoveSendTextOutputCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No SMS alerts configured"
                                                   FontStyle="Italic" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SendTextOutputs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Send Email -->
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="📧  Send Email"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Button Content="+ Add"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,2" FontSize="10"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding AddSendEmailOutputCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SendEmailOutputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="3"
                                                            Padding="8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Email Address:"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Text="{Binding EmailAddress, Mode=TwoWay}"
                                                                         Margin="0,0,0,5"/>
                                                                <TextBlock Text="Subject:"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Text="{Binding Subject, Mode=TwoWay}"
                                                                         Margin="0,0,0,5"/>
                                                                <TextBlock Text="Body:"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Text="{Binding Body, Mode=TwoWay}"
                                                                         Height="52" TextWrapping="Wrap"
                                                                         AcceptsReturn="True"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="5,2" FontSize="11" Margin="6,0,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Command="{Binding DataContext.RemoveSendEmailOutputCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No email alerts configured"
                                                   FontStyle="Italic" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SendEmailOutputs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Send API Request -->
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="🌐  Send API Request"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ForegroundBrush}"/>
                                            <Button Content="+ Add"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,2" FontSize="10"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding AddSendApiOutputCommand}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SendApiOutputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="3"
                                                            Padding="8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="API Endpoint URL:"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Text="{Binding ApiUrl, Mode=TwoWay}"
                                                                         Margin="0,0,0,5"/>
                                                                <Grid Margin="0,0,0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="8"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Method:" FontSize="10"
                                                                                   Margin="0,0,0,3"
                                                                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                        <ComboBox SelectedItem="{Binding HttpMethod, Mode=TwoWay}">
                                                                            <ComboBoxItem Content="GET"/>
                                                                            <ComboBoxItem Content="POST"/>
                                                                            <ComboBoxItem Content="PUT"/>
                                                                            <ComboBoxItem Content="DELETE"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Content Type:" FontSize="10"
                                                                                   Margin="0,0,0,3"
                                                                                   Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                        <ComboBox SelectedItem="{Binding ContentType, Mode=TwoWay}">
                                                                            <ComboBoxItem Content="application/json"/>
                                                                            <ComboBoxItem Content="application/xml"/>
                                                                            <ComboBoxItem Content="text/plain"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Text="Request Body (JSON/XML):"
                                                                           FontSize="10" Margin="0,0,0,3"
                                                                           Foreground="{DynamicResource ForegroundDimBrush}"/>
                                                                <TextBox Text="{Binding RequestBody, Mode=TwoWay}"
                                                                         Height="52" TextWrapping="Wrap"
                                                                         AcceptsReturn="True"
                                                                         FontFamily="Consolas"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="5,2" FontSize="11" Margin="6,0,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Command="{Binding DataContext.RemoveSendApiOutputCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No API requests configured"
                                                   FontStyle="Italic" FontSize="10"
                                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SendApiOutputs.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>

        </Grid>

        <!-- ═══════ ROW 2 — SUMMARY STRIP ════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,9">
            <TextBlock FontSize="12" Foreground="{DynamicResource ForegroundBrush}">
                <Run Text="When " Foreground="{DynamicResource ForegroundDimBrush}"/>
                <Run Text="{Binding SelectedInputsCount, Mode=OneWay}"
                     Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                <Run Text=" input(s) trigger with " Foreground="{DynamicResource ForegroundDimBrush}"/>
                <Run Text="{Binding CauseEffect.LogicGate}"
                     Foreground="{DynamicResource WarningBrush}" FontWeight="Bold"/>
                <Run Text=" logic, activate " Foreground="{DynamicResource ForegroundDimBrush}"/>
                <Run Text="{Binding SelectedOutputsCount, Mode=OneWay}"
                     Foreground="{DynamicResource SecondaryBrush}" FontWeight="Bold"/>
                <Run Text=" output(s)." Foreground="{DynamicResource ForegroundDimBrush}"/>
            </TextBlock>
        </Border>

    </Grid>
</UserControl>
