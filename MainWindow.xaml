<Window x:Class="BlackBoxControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:BlackBoxControl.ViewModels"
        xmlns:views="clr-namespace:BlackBoxControl"
        Title="Fire Panel Simulation"
        Height="680" Width="1280"
        MinHeight="520" MinWidth="960"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

  <Border CornerRadius="12" Background="{DynamicResource BackgroundBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.65" Color="Black"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ─── Title Bar ──────────────────────────────── -->
      <Border Grid.Row="0"
              CornerRadius="12,12,0,0"
              Background="{DynamicResource TitleBarBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Branding -->
          <StackPanel Grid.Column="0" Orientation="Horizontal"
                      Margin="15,0,0,0" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
            <TextBlock Text="BAAMIIS LTD  |  Fire Panel Configurator"
                       Foreground="{DynamicResource ForegroundBrush}"
                       FontSize="12" FontWeight="Medium" FontFamily="Segoe UI"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Window title centred -->
          <TextBlock Grid.Column="1"
                     Text="{Binding WindowTitle}"
                     Foreground="{DynamicResource ForegroundDimBrush}"
                     FontSize="12" FontFamily="Segoe UI"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

          <!-- Window controls -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">

            <Button x:Name="btnMinimize" Width="40" Height="40"
                    Content="−" FontSize="16" Cursor="Hand"
                    BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"
                    FontFamily="Segoe UI" ToolTip="Minimize"
                    Click="btnMinimize_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <Button x:Name="btnMaximise" Width="40" Height="40"
                    Content="□" FontSize="14" Cursor="Hand"
                    BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"
                    FontFamily="Segoe UI" ToolTip="Maximize"
                    Click="btnMaximise_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <Button x:Name="btnClose" Width="40" Height="40"
                    Content="✕" FontSize="14" Cursor="Hand"
                    BorderThickness="0" Foreground="{DynamicResource ForegroundBrush}"
                    FontFamily="Segoe UI" ToolTip="Close"
                    Click="btnClose_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

          </StackPanel>
        </Grid>
      </Border>

      <!-- ─── Menu Bar ───────────────────────────────── -->
      <Border Grid.Row="1"
              Background="{DynamicResource MenuBarBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Menu DataContext="{Binding MenuViewModel}"
              Background="Transparent" Height="32">

          <MenuItem Header="File" Style="{StaticResource CustomMenuItemStyle}">
            <MenuItem Header="New Project"      Command="{Binding NewProjectCommand}"      Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="Open Project"     Command="{Binding OpenProjectCommand}"     Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="Open Recent"      ItemsSource="{Binding RecentProjects}">
              <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CustomMenuItemStyle}">
                  <Setter Property="Header"           Value="{Binding FileName}"/>
                  <Setter Property="ToolTip"          Value="{Binding FilePath}"/>
                  <Setter Property="Command"          Value="{Binding OpenCommand}"/>
                  <Setter Property="CommandParameter" Value="{Binding FilePath}"/>
                </Style>
              </MenuItem.ItemContainerStyle>
              <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CustomMenuItemStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RecentProjects.Count}" Value="0">
                      <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </MenuItem.Style>
            </MenuItem>
            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
            <MenuItem Header="Close Project"    Command="{Binding CloseProjectCommand}"    Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="Save Project"     Command="{Binding SaveProjectCommand}"     Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="Save Project As"  Command="{Binding SaveProjectAsCommand}"   Style="{StaticResource CustomMenuItemStyle}"/>
            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
            <MenuItem Header="Import Project"   Command="{Binding ImportProjectCommand}"   Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="Export Project"   Command="{Binding ExportProjectCommand}"   Style="{StaticResource CustomMenuItemStyle}"/>
            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
            <MenuItem Header="Exit"             Command="{Binding ExitCommand}"            Style="{StaticResource CustomMenuItemStyle}"/>
          </MenuItem>

          <MenuItem Header="Monitor" Style="{StaticResource CustomMenuItemStyle}">
            <MenuItem Header="Monitor Panel" Command="{Binding MonitorPanelCommand}" Style="{StaticResource CustomMenuItemStyle}"/>
          </MenuItem>

          <MenuItem Header="Themes" Style="{StaticResource CustomMenuItemStyle}">
            <MenuItem Header="Dark (Charcoal)"  Command="{Binding DarkThemeCommand}"  Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="Blue (Navy)"      Command="{Binding BlueThemeCommand}"  Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="Green (Forest)"   Command="{Binding GreenThemeCommand}" Style="{StaticResource CustomMenuItemStyle}"/>
          </MenuItem>

          <MenuItem Header="Upload to ESP32"      Command="{Binding UploadConfigurationCommand}" Style="{StaticResource CustomMenuItemStyle}"/>
          <MenuItem Header="Download from Panel"  Command="{Binding DownloadFromPanelCommand}"   Style="{StaticResource CustomMenuItemStyle}"/>

          <MenuItem Header="Simulator" Style="{StaticResource CustomMenuItemStyle}">
            <MenuItem Header="Reset Simulator" Command="{Binding ResetSimulatorCommand}" Style="{StaticResource CustomMenuItemStyle}"/>
          </MenuItem>

          <MenuItem Header="Help" Style="{StaticResource CustomMenuItemStyle}">
            <MenuItem Header="Documentation" Command="{Binding DocumentationCommand}" Style="{StaticResource CustomMenuItemStyle}"/>
            <MenuItem Header="About"         Command="{Binding AboutCommand}"         Style="{StaticResource CustomMenuItemStyle}"/>
          </MenuItem>

        </Menu>
      </Border>

      <!-- ─── Main Content ──────────────────────────── -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="270" MinWidth="180" MaxWidth="420"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel — Panel Explorer -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Explorer Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="▤" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="PANEL EXPLORER"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"/>
              </StackPanel>
            </Border>

            <!-- Tree View -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
              <TreeView AllowDrop="True"
                        ItemsSource="{Binding BlackBoxControlPanels}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderThickness="0"
                        Padding="6"
                        SelectedItemChanged="TreeView_SelectedItemChanged"
                        Drop="Device_Drop">

                <TreeView.ItemContainerStyle>
                  <Style TargetType="TreeViewItem">
                    <Setter Property="AllowDrop"  Value="True"/>
                    <Setter Property="Foreground"  Value="{DynamicResource ForegroundBrush}"/>
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"     Value="4"/>
                    <Setter Property="IsExpanded"  Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <EventSetter Event="Drop" Handler="Device_Drop"/>
                    <Style.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                  <!-- PANEL -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:BlackBoxControlPanelViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                          <Rectangle Width="20" Height="18" Canvas.Left="2" Canvas.Top="3"
                                     Fill="{DynamicResource PrimaryBrush}" RadiusX="1" RadiusY="1"/>
                          <Ellipse Width="3" Height="3" Canvas.Left="5"  Canvas.Top="6" Fill="{DynamicResource SuccessBrush}"/>
                          <Ellipse Width="3" Height="3" Canvas.Left="10" Canvas.Top="6" Fill="{DynamicResource WarningBrush}"/>
                          <Ellipse Width="3" Height="3" Canvas.Left="15" Canvas.Top="6" Fill="{DynamicResource DangerBrush}"/>
                          <Rectangle Width="16" Height="1.5" Canvas.Left="4" Canvas.Top="12" Fill="#60FFFFFF"/>
                          <Rectangle Width="16" Height="1.5" Canvas.Left="4" Canvas.Top="16" Fill="#40FFFFFF"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock Text="{Binding Panel.PanelName}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                  <!-- LOOP -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:LoopViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding Loop.LoopName}" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                  <!-- LOOP DEVICE -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:LoopDeviceViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <Image Source="{Binding Device.ImagePath}" Width="16" Height="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding NodeName}" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                  <!-- BUS -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:BusViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="⬡" Margin="0,0,7,0" Foreground="{DynamicResource WarningBrush}"/>
                      <TextBlock Text="{Binding Bus.BusName}" FontWeight="Medium"
                                 Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                  <!-- BUS NODE -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:BusNodeViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <Image Source="{Binding Node.ImagePath}" Width="16" Height="16" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding Node.Name}" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                  <!-- C&E LIST -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:CauseAndEffectsListViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="⚡" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock Text="Cause &amp; Effects" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                  <!-- SINGLE C&E -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:CauseAndEffectViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="⚡" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                  <!-- GENERIC TREE NODE -->
                  <HierarchicalDataTemplate DataType="{x:Type viewModels:TreeNodeViewModel}"
                                            ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Icon}" Margin="0,0,7,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundDimBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NodeType}" Value="CauseEffectInput">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding NodeType}" Value="CauseEffectOutput">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding NodeType}" Value="Device">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ForegroundBrush}"/>
                    </StackPanel>
                  </HierarchicalDataTemplate>

                </TreeView.Resources>
              </TreeView>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Splitter (vertical, between explorer and content) -->
        <GridSplitter Grid.Column="1"
                      Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ShowsPreview="True" Cursor="SizeWE"/>

        <!-- Right Panel — Content + Palette -->
        <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="155" MinHeight="90" MaxHeight="260"/>
          </Grid.RowDefinitions>

          <!-- Dynamic Form Content -->
          <Border Grid.Row="0" Margin="12">
            <ContentControl Content="{Binding SelectedForm}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
              <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewModels:BlackBoxControlPanelViewModel}">
                  <views:BlackBoxControlForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:LoopViewModel}">
                  <views:LoopForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:LoopDeviceViewModel}">
                  <views:LoopDeviceForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:BusNodeViewModel}">
                  <views:BusNodeForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:BusViewModel}">
                  <views:BusForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:CauseAndEffectViewModel}">
                  <views:CauseAndEffectForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:CauseAndEffectsListViewModel}">
                  <views:CauseAndEffectsListForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:TimeOfDayInputViewModel}">
                  <views:TimeOfDayInputForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:DateTimeInputViewModel}">
                  <views:DateTimeInputForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:DeviceInputViewModel}">
                  <views:DeviceInputForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:SendTextOutputViewModel}">
                  <views:SendTextOutputForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:SendEmailOutputViewModel}">
                  <views:SendEmailOutputForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:SendApiOutputViewModel}">
                  <views:SendApiOutputForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:DeviceOutputViewModel}">
                  <views:DeviceOutputForm DataContext="{Binding}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ReceiveApiInputViewModel}">
                  <views:ReceiveApiInputForm DataContext="{Binding}"/>
                </DataTemplate>
              </ContentControl.Resources>
            </ContentControl>
          </Border>

          <!-- Horizontal GridSplitter between form and palette -->
          <GridSplitter Grid.Row="1"
                        Height="5" HorizontalAlignment="Stretch"
                        Background="{DynamicResource BorderBrush}"
                        ShowsPreview="True" Cursor="SizeNS"/>

          <!-- Device Palette -->
          <Border Grid.Row="2"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,0"
                  Padding="10,8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Palette Header -->
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="DEVICE PALETTE"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           FontFamily="Segoe UI"/>
                <TextBlock Text=" — click a device to add it to the selected loop or bus"
                           FontSize="11"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           FontFamily="Segoe UI"/>
              </StackPanel>

              <!-- Scrollable palette -->
              <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <StackPanel>

                  <!-- Loop devices -->
                  <ItemsControl ItemsSource="{Binding DevicePalette.AllowedDevices}">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsBusSelected}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="76" Height="92" Margin="4"
                                Background="{DynamicResource TitleBarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Cursor="Hand" ToolTip="{Binding Type}">
                          <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.AddDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                          </Border.InputBindings>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding ImagePath}" Width="44" Height="44" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Type}" FontSize="9"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Bus nodes -->
                  <ItemsControl ItemsSource="{Binding DevicePalette.AvailableBusNodes}">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsBusSelected}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="76" Height="92" Margin="4"
                                Background="{DynamicResource TitleBarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Cursor="Hand" ToolTip="{Binding Name}">
                          <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.AddBusNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                          </Border.InputBindings>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding ImagePath}" Width="44" Height="44" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Name}" FontSize="9"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
