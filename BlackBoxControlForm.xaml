<UserControl x:Class="BlackBoxControl.BlackBoxControlForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="BlackBoxControlPanelConfig"
             Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sticky Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}"
                        Width="36" Height="36" CornerRadius="4" Margin="0,0,12,0">
                    <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="White"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Fire Panel Configuration"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Configure panel settings and properties"
                               FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">

                    <GroupBox Header="Panel Information" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Panel Name:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Panel.PanelName}" Margin="0,0,0,8"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Location:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Panel.Location}" Margin="0,0,0,8"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Panel Address:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Panel.PanelAddress}" Margin="0,0,0,8"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="No. of Loops:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Panel.NumberOfLoops}" Margin="0,0,0,8"/>
                            <Label Grid.Row="4" Grid.Column="0" Content="No. of Zones:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Panel.NumberOfZones}" Margin="0,0,0,8"/>
                            <Label Grid.Row="5" Grid.Column="0" Content="Config Good:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Panel.ConfigGood}" Margin="0,0,0,8"/>
                            <Label Grid.Row="6" Grid.Column="0" Content="Firmware:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Panel.FirmwareVersion}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Loop Settings" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Default Volume:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Panel.LPSDefVol}" Margin="0,0,0,8"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Default Tone:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Panel.LPSDefTone}" Margin="0,0,0,8"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Loop Offset:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Panel.LoopOffset}" Margin="0,0,0,8"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="IS Devices Fitted:" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Panel.ISDevices}" VerticalAlignment="Center"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Time and Date" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Year:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Panel.TSYear}" Margin="0,0,0,8"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Month:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Panel.TSMonth}" Margin="0,0,0,8"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Day:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Panel.TSDay}" Margin="0,0,0,8"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="Hour:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Panel.TSHour}" Margin="0,0,0,8"/>
                            <Label Grid.Row="4" Grid.Column="0" Content="Minute:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Panel.TSMinute}"/>
                        </Grid>
                    </GroupBox>

                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="2">

                    <GroupBox Header="Network Configuration" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Node Address:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Panel.NodeAddress}" Margin="0,0,0,8"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Network Card:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Panel.NetCardAddress}" Margin="0,0,0,8"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="WiFi SSID:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Panel.WiFiSSID}" Margin="0,0,0,8"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="WiFi Password:" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" PasswordChanged="PasswordBox_PasswordChanged"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Cause and Effect Settings" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Total C and E:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Panel.NumberOfCauseAndEffects}" Margin="0,0,0,8"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="No. of Causes:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Panel.NumCECauses}" Margin="0,0,0,8"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="No. of Effects:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Panel.NumCEEffects}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Panel Power Settings" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Battery Capacity:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Panel.BatteryCapacity}" Margin="0,0,0,8"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Battery Count:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Panel.NumberOfBatteries}" Margin="0,0,0,8"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Power Supplies:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Panel.NumberOfPowerSupplies}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Panel Image" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Image Path:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Panel.ImagePath}"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Padding="8" HorizontalAlignment="Center">
                                <Image Source="{Binding Panel.ImagePath}"
                                       Height="150" Width="150" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Sticky Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="Save Changes"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="110"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
