<UserControl x:Class="BlackBoxControl.LoopForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="LoopConfig"
             Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sticky Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- inline stats -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}"
                        Width="36" Height="36" CornerRadius="4" Margin="0,0,12,0">
                    <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Loop Configuration" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="Configure loop settings and connected devices"
                               FontSize="11" Foreground="{DynamicResource ForegroundDimBrush}"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="14,6" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="DEVICES" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Loop.NumberOfDevices}" FontSize="20"
                                   FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="14,6">
                    <StackPanel>
                        <TextBlock Text="PROTOCOL" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundDimBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Loop.LoopProtocol}" FontSize="12"
                                   FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column — Loop Info -->
            <StackPanel Grid.Column="0">

                <GroupBox Header="Loop Information" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Loop Number:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Loop.LoopNumber, Mode=TwoWay}"
                                 Margin="0,0,0,8"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Loop Name:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding Loop.LoopName, Mode=TwoWay}"
                                 Margin="0,0,0,8"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Loop Protocol:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding Protocols}"
                                  SelectedItem="{Binding Loop.LoopProtocol, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Device Count:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding Loop.NumberOfDevices, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource SurfaceBrush}"
                                 ToolTip="Automatically calculated"/>
                    </Grid>
                </GroupBox>

                <!-- Quick tips -->
                <GroupBox Header="Quick Tips" Padding="14">
                    <StackPanel>
                        <Border Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Loop number must be unique within the panel"
                                           FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Select the appropriate protocol for your devices"
                                           FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="•" Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="Device count updates automatically as you add devices"
                                           FontSize="12" Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <!-- Right Column — Loop Image -->
            <StackPanel Grid.Column="2">

                <GroupBox Header="Loop Image" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Image Path:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Loop.ImagePath, ElementName=LoopConfig}"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource SurfaceBrush}"
                                Padding="12" HorizontalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding Loop.ImagePath, ElementName=LoopConfig}"
                                       Height="180" Width="180" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Loop.ImagePath, ElementName=LoopConfig}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Loop.ImagePath, ElementName=LoopConfig}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Ellipse Width="60" Height="60"
                                             Fill="{DynamicResource BorderBrush}"
                                             HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="No Image"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Specify a path above"
                                               Foreground="{DynamicResource ForegroundDimBrush}"
                                               FontSize="11" HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Info tip -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SecondaryBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14"
                                 Fill="{DynamicResource SecondaryBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock Text="Devices can be added by dragging from the device palette onto this loop in the Panel Explorer."
                                   FontSize="11" Foreground="{DynamicResource ForegroundBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- Sticky Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="90" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="Save Changes"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="110"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
